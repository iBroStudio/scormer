{
  "name": "astro-skeleton",
  "type": "module",
  "version": "1.2.0",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "format": "bun run format:i18n && bun run format:src && bun run format-stores",
    "format:i18n": "biome check --write ./i18n",
    "format:src": "biome check --write ./src",
    "format:stores": "biome check --write ./stores",
    "astro": "astro",
    "i18n:scan": "i18next",
    "i18n:export": "node i18n/export.js",
    "i18n:import": "node i18n/import.js",
    "prepare": "husky",
    "scorm": "bun run build && ./scorm generate",
    "test": "bunx playwright test",
    "test:tag": "bunx playwright test --grep $npm_config_name",
    "test:desktop": "bunx playwright test --project=chromium",
    "test:desktop:tag": "bunx playwright test --grep $npm_config_name",
    "test:chrome": "bunx playwright test --project=chromium --project=firefox --project=webkit",
    "test:chrome:tag": "bunx playwright test  --project=chromium --project=firefox --project=webkit --grep $npm_config_name",
    "test:firefox": "bunx playwright test --project=firefox",
    "test:firefox:tag": "bunx playwright test --project=firefox --grep $npm_config_name",
    "test:safari": "bunx playwright test --project=webkit",
    "test:safari:tag": "bunx playwright test --project=webkit --grep $npm_config_name",
    "test:mobile": "bunx playwright test --project=android --project=ios",
    "test:mobile:tag": "bunx playwright test --project=android --project=ios --grep $npm_config_name",
    "test:android": "bunx playwright test --project=android",
    "test:android:tag": "bunx playwright test --project=android --grep $npm_config_name",
    "test:ios": "bunx playwright test --project=ios",
    "test:ios:tag": "bunx playwright test --project=ios --grep $npm_config_name"
  },
  "dependencies": {
    "@astrojs/react": "4.2.4",
    "@astrojs/tailwind": "6.0.2",
    "@gamestdio/scorm": "^0.1.3",
    "@headlessui/react": "^2.2.1",
    "@nanostores/persistent": "^0.10.2",
    "@nanostores/react": "^0.8.4",
    "astro": "5.6.2",
    "astro-plyr": "^1.1.0",
    "astro-react-i18next": "^0.3.1",
    "astro-relative-links": "^0.4.2",
    "clsx": "^2.1.1",
    "howler": "^2.2.4",
    "i18next": "^24.2.2",
    "motion": "^12.7.2",
    "nanostores": "^0.11.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-responsive-modal": "^6.4.2",
    "swiper": "^11.2.5",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.4",
    "@biomejs/biome": "^1.9.4",
    "@commitlint/cli": "^19.7.1",
    "@commitlint/config-conventional": "^19.7.1",
    "@playwright/test": "^1.50.1",
    "@types/howler": "^2.2.12",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "csv": "^6.3.11",
    "husky": "^9.1.7",
    "i18next-parser": "^9.3.0",
    "jsonfile": "^6.1.0",
    "typescript": "^5.8.2"
  }
}
